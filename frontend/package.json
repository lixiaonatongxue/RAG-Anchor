{
  "name": "rag-anchor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAG-Anchor PDF evidence explorer frontend",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "pdfjs-dist": "4.8.69"
  },
  "devDependencies": {
    "@types/node": "18.19.86",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
