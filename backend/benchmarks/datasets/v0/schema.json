{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAG-Anchor anchoring benchmark sample specification",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "scenario",
    "title",
    "evaluation",
    "truth_level",
    "page_size",
    "rotation",
    "cropbox",
    "pages",
    "queries",
    "match_radius_pt",
    "min_separation_pt"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "evaluation": {"enum": ["direct", "boundary", "unsupported"]},
    "truth_level": {"enum": ["layout-exact", "layout-band", "detection-only", "boundary"]},
    "page_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "rotation": {"enum": [0, 90, 180, 270]},
    "cropbox": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        }
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lines"],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["baseline_y", "segments"],
              "properties": {
                "baseline_y": {"type": "number"},
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["x", "text", "font", "size"],
                    "properties": {
                      "x": {"type": "number"},
                      "text": {"type": "string", "minLength": 1},
                      "font": {"type": "string", "minLength": 1},
                      "size": {"type": "number", "exclusiveMinimum": 0}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "match_case", "expected"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "match_case": {"type": "boolean"},
          "expected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["page_index", "parts"],
              "properties": {
                "page_index": {"type": "integer", "minimum": 0},
                "parts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["line_index", "segment_index", "char_offset", "char_length"],
                    "properties": {
                      "line_index": {"type": "integer", "minimum": 0},
                      "segment_index": {"type": "integer", "minimum": 0},
                      "char_offset": {"type": "integer", "minimum": 0},
                      "char_length": {"type": "integer", "minimum": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "match_radius_pt": {"type": "number", "exclusiveMinimum": 0},
    "min_separation_pt": {"type": "number", "minimum": 0}
  }
}
